{
  "project_name": "Neural CCTV Analyser",
  "camera": {
    "camera_id": "FRONT_PORCH_CAM_01",
    "location": "Front Doorstep & Driveway",
    "target_fps": 30
  },
  "motion_gate": {
    "enabled": true,
    "chunk_size": 10,
    "motion_threshold": 0.70,
    "downsample_size": [320, 180]
  },
  "zones": [
    {
      "zone_id": "ZONE_DOORSTEP",
      "name": "doorstep",
      "polygon": [
        [0.42, 0.42],
        [0.82, 0.42],
        [0.82, 0.90],
        [0.42, 0.90]
      ],
      "alert_level": "NOTICE"
    },
    {
      "zone_id": "ZONE_DRIVEWAY",
      "name": "driveway",
      "polygon": [
        [0.05, 0.35],
        [0.40, 0.35],
        [0.40, 0.95],
        [0.05, 0.95]
      ],
      "alert_level": "INFO"
    },
    {
      "zone_id": "ZONE_WALKWAY",
      "name": "porch walkway",
      "polygon": [
        [0.40, 0.28],
        [0.75, 0.28],
        [0.75, 0.50],
        [0.40, 0.50]
      ],
      "alert_level": "INFO"
    }
  ],
  "virtual_fence": {
    "enabled": true,
    "line": [
      [0.05, 0.65],
      [0.95, 0.65]
    ],
    "direction_label_positive": "Approaching Doorstep",
    "direction_label_negative": "Exiting Property"
  },
  "face_recognition": {
    "enabled": true,
    "distance_threshold": 0.38,
    "db_path": "./data/face_db",
    "unknown_dir": "./data/unknown_faces"
  },
  "yolo": {
    "model_path": "yolov8n.pt",
    "confidence": 0.35,
    "device": "auto"
  },
  "logging": {
    "output_log": "cctv_activity.log",
    "json_log": "cctv_activity.jsonl",
    "cooldown_seconds": 3.5
  }
}
